rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Skeleton JSONs: admin upload only (paste the same admin uid as firestore.rules)
    match /skeletons/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'PASTE_ADMIN_UID_HERE';
    }

    // Community photos: only into your own folder, images under 5 MB
    match /posts/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Everything else (existing uploads): public read, no writes
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
